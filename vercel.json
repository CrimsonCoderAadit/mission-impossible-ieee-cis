{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/mission-impossible-rulebook.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"mission-impossible-rulebook.pdf\"" }
      ]
    }
  ]
}
